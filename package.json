    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "cheerio-without-node-native": "0.20.2",
    "crypto-js": "^4.2.0",
    "dayjs": "1.11.9",
    "eslint": "8.56.0",
