{
  "name": "bangumi",
  "version": "8.39.4",
  "main": "index.js",
  "private": true,
  "scripts": {
    "dev": "expo start --max-workers 4",
    "dev:offline": "expo start --offline --max-workers 4",
    "dev:tee": "yarn dev | tee -a output.txt",
    "postinstall": "patch-package",
    "env": "node ./packages/env.js",
    "k": "sudo purge",
    "kj": "ps -ef | grep java | awk 'NR==1 {print }' | xargs kill -15",
    "kp": "lsof -i :8081 | awk 'NR>1 {print }' | xargs kill",
    "adb": "adb reverse tcp:8081 tcp:8081",
    "android": "cd android && ./gradlew assembleRelease",
    "apk": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res/ && cd android && ./gradlew assembleRelease",
    "web": "cross-env EXPO_PUBLIC_ORIGIN=web expo start --web",
    "web:build": "cross-env EXPO_PUBLIC_ORIGIN=web expo export --platform web",
    "web:serve": "serve dist --single",
    "test": "jest --detectOpenHandles",
    "test:watch": "jest --watch --forceExit",
    "coverage": "jest --coverage",
    "pb:verify": "node scripts/pb-verify.js",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:styles": "npx eslint 'src/**/styles.ts'",
    "lint:imports": "npx eslint 'src/**/*.{ts,tsx}' --quiet --config eslint-rules/.eslintrc.check-imports.js",
    "start": "expo start --dev-client"
  },
  "resolutions": {
    "define-properties": "1.2.0",
    "use-latest-callback": "0.1.9"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/blur": "4.2.0",
    "@react-native-community/cameraroll": "4.1.2",
    "@react-native-community/slider": "5.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/bottom-tabs": "7.18.18",
    "@react-navigation/native": "7.3.18",
    "@react-navigation/native-stack": "7.18.10",
    "@sdcx/nested-scroll": "^0.14.0",
    "@types/react": "~19.2.2",
    "cheerio": "1.0.0",
    "core-js": "3.36.0",
    "expo": "~57.0.20",
    "expo-asset": "~57.0.16",
    "expo-blur": "~57.0.2",
    "expo-calendar": "~57.0.2",
    "expo-constants": "~57.0.17",
    "expo-device": "~57.0.1",
