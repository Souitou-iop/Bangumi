    "expo-image": "~57.0.4",
    "expo-linear-gradient": "~57.0.1",
    "expo-screen-orientation": "~57.0.2",
    "expo-speech": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-updates": "~57.0.21",
    "expo-web-browser": "~57.0.2",
    "htmlparser2": "^3.9.0",
    "mobx": "6.12.3",
    "mobx-react": "9.1.1",
    "patch-package": "6.4.7",
    "postinstall-postinstall": "2.1.0",
    "react": "19.2.3",
