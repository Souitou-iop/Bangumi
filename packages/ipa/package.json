{
  "name": "bangumi",
  "version": "8.39.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "dev": "expo start",
    "dev:tee": "yarn dev | tee -a output.txt",
    "dev:offline": "EXPO_USE_EXOTIC=0 expo start --offline",
    "postinstall": "patch-package",
    "env": "node ./packages/env.js",
    "k": "sudo purge",
    "kj": "ps -ef | grep java | awk 'NR==1 {print $2}' | xargs kill -15",
    "adb": "adb reverse tcp:8081 tcp:8081",
    "android": "cd android && ./gradlew assembleRelease",
    "apk": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res/ && cd android && ./gradlew assembleRelease",
    "web": "cross-env EXPO_PUBLIC_ORIGIN=web expo start --web",
    "web:build": "cross-env EXPO_PUBLIC_ORIGIN=web expo export --platform web",
    "web:serve": "serve dist --single",
    "test": "jest",
    "coverage": "jest --coverage",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "start": "expo start --dev-client"
  },
